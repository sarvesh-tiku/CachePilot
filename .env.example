CACHEPILOT_ENVIRONMENT=local
CACHEPILOT_DATABASE_URL=sqlite+aiosqlite:///./cachepilot.db
CACHEPILOT_SIMULATED_WORKER_COUNT=3
CACHEPILOT_WORKER_HEARTBEAT_INTERVAL_S=1.0
# Simulated worker model: "linear" (fixed penalty per pending request) or "batched"
# (continuous batching with a bounded batch; saturates). See docs/kv-cache-design.md §5.
# CACHEPILOT_SIMULATED_QUEUE_MODEL=linear
# CACHEPILOT_SIMULATED_MAX_BATCH_SIZE=16
# KV bytes per token: explicit, or derived from a model shape (see cachepilot/kv/sizing.py)
# CACHEPILOT_KV_BYTES_PER_TOKEN=524288
# CACHEPILOT_KV_MODEL_PRESET=llama-3-8b
# TTFT estimator (defaults = simulator cost model; refit with `python -m benchmark.fit`)
# CACHEPILOT_TTFT_QUEUE_WAIT_MS_PER_PENDING=12
# CACHEPILOT_TTFT_PREFILL_MS_PER_TOKEN=0.05
# CACHEPILOT_TTFT_FIXED_OVERHEAD_MS=15
